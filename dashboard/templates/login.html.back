<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Sign In | Road Safety Monitor</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="{{ url_for('static', filename='css/style.css') }}"
    />
  </head>

  <body class="bg-dark text-light">
    <div class="container">
      <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-11 col-sm-8 col-md-6 col-lg-4">
          <div class="card bg-secondary text-light shadow-lg border-0">
            <div class="card-body p-4">

              <!-- Header -->
              <div class="text-center mb-4">
                <h2 class="fw-bold">Road Safety Monitor</h2>

                <p class="text-light opacity-75 mb-0">
                  Welcome back
                </p>

                <small class="text-light opacity-75">
                  Sign in to access your traffic dashboard
                </small>
              </div>

              <!-- Error message -->
              {% if error %}
              <div class="alert alert-danger">
                {{ error }}
              </div>
              {% endif %}

              <!-- Login form -->
              <form method="POST" action="{{ url_for('login') }}">

                <div class="mb-3">
                  <label for="username" class="form-label">
                    Username
                  </label>

                  <input
                    type="text"
                    class="form-control"
                    id="username"
                    name="username"
                    placeholder="Enter username"
                    required
                    autofocus
                  />
                </div>

                <div class="mb-3">
                  <label for="password" class="form-label">
                    Password
                  </label>

                  <input
                    type="password"
                    class="form-control"
                    id="password"
                    name="password"
                    placeholder="Enter password"
                    required
                  />
                </div>

                <button
                  type="submit"
                  class="btn btn-primary w-100"
                >
                  Sign In
                </button>

              </form>

              <!-- Registration link -->
              <div class="text-center mt-4">
                <p class="mb-2">
                  Don't have an account?
                  <a
                    href="{{ url_for('register') }}"
                    class="text-info text-decoration-none fw-semibold"
                  >
                    Create an Account
                  </a>
                </p>

                <a
                  href="{{ url_for('index') }}"
                  class="text-light text-decoration-none small"
                >
                  ← Continue as Guest
                </a>
              </div>

              <!-- Footer -->
              <div class="text-center mt-4">
                <small class="text-light opacity-75">
                  AI-Based Road Safety and Traffic Monitoring System
                </small>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>